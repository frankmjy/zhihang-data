# Standalone intranet keepalive configuration.
# Copy this file to .env.keepalive next to intranet-keepalive.js on a migrated PC.

INTRANET_KEEPALIVE_ENABLED=true
INTRANET_KEEPALIVE_DEBUG_PORT=9222
INTRANET_KEEPALIVE_ORIGINS=https://risk.example.internal,https://change.example.internal,https://emergencydrill.meta42.indc.vnet.com,https://event.example.internal,https://inspect2.meta42.indc.vnet.com
INTRANET_KEEPALIVE_PATH=/
INTRANET_KEEPALIVE_INTERVAL_MS=300000
INTRANET_KEEPALIVE_START_DELAY_MS=30000
INTRANET_KEEPALIVE_RETRY_MS=60000
INTRANET_KEEPALIVE_MAX_FAILURE_BACKOFF_MS=900000
INTRANET_KEEPALIVE_REQUEST_TIMEOUT_MS=8000
INTRANET_KEEPALIVE_DEVTOOLS_TIMEOUT_MS=5000
INTRANET_KEEPALIVE_BROWSER_START_WAIT_MS=10000

# Optional. Leave blank to auto-detect Chrome or Edge.
INTRANET_KEEPALIVE_BROWSER_PATH=

# Optional. Use a dedicated profile so normal browser windows are not affected.
INTRANET_KEEPALIVE_PROFILE_DIR=.run/intranet-keepalive-profile
